{
  "expo": {
    "name": "habitera",
    "slug": "habitera",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#678B83",
          "image": "./assets/images/splash-full.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app needs access to your location to show nearby properties."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Habitera to access your photos so you can set a profile picture."
        }
      ],
      "react-native-maps"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.habitera"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#678B83"
      },
      "package": "com.anonymous.habitera"
    }
  }
}
