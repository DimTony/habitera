# Optional override for the Habitera API base URL (no trailing slash).
# Leave unset in local Expo Go / simulator so the app uses the Expo host automatically.
# Physical device example: http://192.168.1.7:5141
# Android emulator fallback (when auto-detect is unavailable): http://10.0.2.2:5141
# EXPO_PUBLIC_API_URL=http://192.168.1.7:5141

# Google ads (web AdSense in-feed / native AdMob unit)
# EXPO_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# EXPO_PUBLIC_ADSENSE_HOME_FEED_SLOT=xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_HOME_FEED_UNIT_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
